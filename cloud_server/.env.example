# ==========================================================
# AI-Based QR Printing System - Cloud Server Environment
# ==========================================================

ENVIRONMENT=production
DEBUG=false
BASE_URL=https://api.yourdomain.com
API_BASE_URL=https://api.yourdomain.com/api
WEBSOCKET_URL=wss://api.yourdomain.com/ws/printer

DATABASE_URL=postgresql://db_user:db_password@localhost:5432/ai_printing
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

JWT_SECRET=your-random-production-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

PAYMENT_GATEWAY_PROVIDER=MANUAL
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

MODEL_PATH=models/print_time_predictor.joblib
ML_MIN_TRAINING_RECORDS=20

CORS_ORIGINS=*

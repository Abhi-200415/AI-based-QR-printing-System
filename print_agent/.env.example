# ==========================================================
# Windows Print Agent - Configuration Template
# ==========================================================

# Production or staging Cloud Server Base URL (HTTPS in production)
CLOUD_API_URL=https://api.yourdomain.com

# Production WebSocket endpoint (WSS in production)
WEBSOCKET_URL=wss://api.yourdomain.com/ws/printer

# Unique Agent identifier for this machine
AGENT_ID=agent_shop_01

# Shop Owner ID (UUID from Cloud Owner Registration)
SHOP_ID=your-shop-owner-uuid-here

# Local temporary download directory for print jobs
DOWNLOAD_FOLDER=downloads

# Heartbeat interval in seconds
HEARTBEAT_INTERVAL=30

# Retry configuration
MAX_RETRY=3
RETRY_DELAY=5
PRINTER_SYNC_INTERVAL=60

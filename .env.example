# ==========================================================
# AI-Based QR Printing System - Root Configuration Template
# ==========================================================

# Cloud Server Configuration
ENVIRONMENT=production
DEBUG=false
BASE_URL=https://api.yourdomain.com
API_BASE_URL=https://api.yourdomain.com/api
WEBSOCKET_URL=wss://api.yourdomain.com/ws/printer

# Database Configuration (PostgreSQL in production)
DATABASE_URL=postgresql://db_user:db_password@localhost:5432/ai_printing
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# Security / JWT
JWT_SECRET=your-random-production-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# File Upload & Security
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Payment Gateway Configuration (RAZORPAY, CASHFREE, STRIPE, or MANUAL)
PAYMENT_GATEWAY_PROVIDER=MANUAL
PAYMENT_GATEWAY_KEY_ID=rzp_live_your_key_id
PAYMENT_GATEWAY_KEY_SECRET=your_gateway_secret_key
PAYMENT_WEBHOOK_SECRET=your_webhook_signing_secret

# AI / ML Model
MODEL_PATH=models/print_time_predictor.joblib
ML_MIN_TRAINING_RECORDS=20

# CORS Origins (Comma-separated)
CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com
